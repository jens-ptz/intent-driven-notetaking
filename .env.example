# Copy to .env for local development.

# --- database -------------------------------------------------------------
# Host port the dockerized PostgreSQL is published on. 5432 is often already
# taken by a native PostgreSQL, so this project defaults to 5433.
DB_PORT=5433
DATABASE_URL="postgresql://notes:notes@localhost:5433/notes?schema=public"

# --- api ------------------------------------------------------------------
API_PORT=3000
# Origin allowed to send cookies and mutating requests (ADR-0002 CSRF defence).
WEB_ORIGIN="http://localhost:5273"
# Signing key for the access token cookie. Generate your own for anything real.
JWT_SECRET="dev-only-change-me"
# Lifetime of the access token cookie. There is no refresh token (ADR-0002).
JWT_EXPIRES_IN="1h"
# Set to 1 to mark the session cookie Secure. Leave unset for plain-HTTP local work.
COOKIE_SECURE=

# --- seed -----------------------------------------------------------------
# The platform guarantees a hans.admin administrator in every environment.
# This default is for LOCAL DEVELOPMENT ONLY - change it before exposing the
# platform to anyone. See adr/0002 and the risk noted in the change design.
SEED_ADMIN_PASSWORD="p@assw0rt"

# --- web ------------------------------------------------------------------
# 5173 is Vite's default and is often already taken by another project, so this
# project defaults to 5273.
WEB_PORT=5273
